"""
Unit Root Tests: Dickey-Fuller (DF) ve Augmented Dickey-Fuller (ADF)
Gereksinimler: pandas, statsmodels, openpyxl

Veri formatı:
  - 1. sütun : Dönem / Yıl (indeks olarak kullanılır)
  - 2. sütun : Test edilecek seri (başlık adı önemsizdir)
  - Çoklu sütun varsa tüm sayısal sütunlar otomatik test edilir
"""

import pandas as pd
import numpy as np
from statsmodels.tsa.stattools import adfuller

# ─────────────────────────────────────────
# 1. VERİ YÜKLEME
# ─────────────────────────────────────────
FILE_PATH = r"C:\Users\sabridogruyol\OneDrive - Kiğılı Giyim Ticaret A.Ş\Masaüstü\Örnek Veri.xlsx"

df = pd.read_excel(FILE_PATH, index_col=0)  # 1. sütun otomatik indeks

# Yalnızca sayısal sütunları al
df = df.select_dtypes(include=[np.number])

# Her sütunu ayrı bir değişken olarak tanımla (başlık adı ne olursa olsun)
VARIABLES = {col: df[col] for col in df.columns}

# ─────────────────────────────────────────
# 2. TEST FONKSİYONLARI
# ─────────────────────────────────────────

def run_df(series: pd.Series) -> dict:
    """
    Dickey-Fuller Testi (maxlag=0 → gecikme yok, bu DF'nin kendisi)
    regression:
        'n'  → sabit yok, trend yok
        'c'  → sabit var, trend yok
        'ct' → sabit ve trend var
    """
    results = {}
    for reg_label, reg_code in [("Sabit Yok", "n"), ("Sabit", "c"), ("Sabit+Trend", "ct")]:
        stat, pval, _, nobs, crit, _ = adfuller(series.dropna(), maxlag=0, regression=reg_code)
        results[reg_label] = {
            "test_stat": round(stat, 4),
            "p_value": round(pval, 4),
            "n_obs": nobs,
            "crit_1pct": round(crit["1%"], 3),
            "crit_5pct": round(crit["5%"], 3),
            "crit_10pct": round(crit["10%"], 3),
            "karar": "Durağan Değil (H0 Red Edilemedi)" if pval > 0.05 else "Durağan (H0 Reddedildi)",
        }
    return results


def run_adf(series: pd.Series, max_lag: int = 12) -> dict:
    """
    Augmented Dickey-Fuller Testi
    Gecikme seçimi: AIC ile otomatik
    'c'  → sabit var
    'ct' → sabit ve trend var
    """
    results = {}
    for reg_label, reg_code in [("Sabit", "c"), ("Sabit+Trend", "ct")]:
        stat, pval, used_lag, nobs, crit, _ = adfuller(
            series.dropna(), maxlag=max_lag, autolag="AIC", regression=reg_code
        )
        results[reg_label] = {
            "test_stat": round(stat, 4),
            "p_value": round(pval, 4),
            "optimal_lag": used_lag,
            "n_obs": nobs,
            "crit_1pct": round(crit["1%"], 3),
            "crit_5pct": round(crit["5%"], 3),
            "crit_10pct": round(crit["10%"], 3),
            "karar": "Durağan Değil (H0 Red Edilemedi)" if pval > 0.05 else "Durağan (H0 Reddedildi)",
        }
    return results


def differencing_check(series: pd.Series, var_name: str) -> str:
    """
    Entegrasyon derecesi tespiti: I(0), I(1) veya I(2)
    """
    _, p_level, _, _, _, _ = adfuller(series.dropna(), autolag="AIC", regression="c")
    if p_level <= 0.05:
        return f"{var_name}: I(0) — Seviyede durağan"

    diff1 = series.diff().dropna()
    _, p_diff1, _, _, _, _ = adfuller(diff1, autolag="AIC", regression="c")
    if p_diff1 <= 0.05:
        return f"{var_name}: I(1) — Birinci farkta durağan"

    diff2 = diff1.diff().dropna()
    _, p_diff2, _, _, _, _ = adfuller(diff2, autolag="AIC", regression="c")
    if p_diff2 <= 0.05:
        return f"{var_name}: I(2) — İkinci farkta durağan"

    return f"{var_name}: I(?) — İkinci fark sonrası hâlâ durağan değil"


# ─────────────────────────────────────────
# 3. YARDIMCI FONKSİYONLAR
# ─────────────────────────────────────────

def print_section(title: str) -> None:
    print(f"\n{'=' * 65}")
    print(f"  {title}")
    print(f"{'=' * 65}")


def print_result(reg_label: str, res: dict, show_lag: bool = False) -> None:
    lag_info = f"  Optimal Lag: {res['optimal_lag']}" if show_lag else ""
    print(
        f"  [{reg_label}]  "
        f"Stat: {res['test_stat']:>8.4f}  |  "
        f"p-value: {res['p_value']:.4f}  |  "
        f"n: {res['n_obs']}"
        f"{lag_info}"
    )
    print(
        f"           Kritik Değerler → "
        f"1%: {res['crit_1pct']}  "
        f"5%: {res['crit_5pct']}  "
        f"10%: {res['crit_10pct']}"
    )
    print(f"           Karar: {res['karar']}")


# ─────────────────────────────────────────
# 4. ANA ÇALIŞMA DÖNGÜSÜ
# ─────────────────────────────────────────

integration_summary = []

for var_name, series in VARIABLES.items():

    print_section(f"DEĞİŞKEN: {var_name}")

    print("\n  [A] Dickey-Fuller Testi (Gecikme = 0)\n")
    df_results = run_df(series)
    for label, res in df_results.items():
        print_result(label, res, show_lag=False)

    print("\n  [B] Augmented Dickey-Fuller Testi (AIC ile Otomatik Gecikme)\n")
    adf_results = run_adf(series)
    for label, res in adf_results.items():
        print_result(label, res, show_lag=True)

    integration_order = differencing_check(series, var_name)
    integration_summary.append(integration_order)


# ─────────────────────────────────────────
# 5. YÖNETİCİ ÖZETİ
# ─────────────────────────────────────────

print_section("ENTEGRASYon DERECESİ ÖZETİ (ADF, Sabit Modeli, α=0.05)")
for line in integration_summary:
    print(f"  ▸ {line}")

print(
    f"\n  Not: H0 hipotezi 'birim kök vardır (seri durağan değildir)' şeklindedir.\n"
    f"  p > 0.05 → H0 reddedilemez → Seri durağan değil.\n"
    f"  p ≤ 0.05 → H0 reddedilir  → Seri durağan.\n"
)
