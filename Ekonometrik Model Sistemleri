# ENTEGRASYON DERECESİ YARDIMCI
# ─────────────────────────────────────────

def get_integration_order(series):
    for d, s in enumerate([series, series.diff().dropna(), series.diff().diff().dropna()]):
        try:
            _, p, _, _, _, _ = adfuller(s.dropna(), autolag="AIC", regression="c")
            if p <= ALPHA:
                return d
        except Exception:
            pass
    return 2

