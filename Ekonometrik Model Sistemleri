def select_pairs(allow_all=True, johansen=False):
    """
    Kullanıcıdan X ve Y seçimi alır.
    allow_all=True  → 0: tüm çiftler seçeneği gösterilir
    johansen=True   → birden fazla değişken seçilebilir
    """
    print(f"\n  {'─'*40}")
    print(f"  DEĞİŞKEN SEÇİMİ")
    print(f"  {'─'*40}")
    if allow_all:
        print(f"  0  →  Tüm çiftler (otomatik)")
    for i, name in enumerate(VAR_NAMES, 1):
        print(f"  {i}  →  {name}")
    print(f"  {'─'*40}")

    if johansen:
        raw = input("  Dahil edilecek değişkenler (örn: 1 2 3): ").strip()
        if raw == "0" and allow_all:
            return VAR_NAMES
        try:
            idxs = [int(x)-1 for x in raw.split()]
            selected = [VAR_NAMES[i] for i in idxs if 0 <= i < len(VAR_NAMES)]
            if len(selected) < 2:
                print("  [!] En az 2 değişken seçin. Tüm değişkenler kullanılıyor.")
                return VAR_NAMES
            return selected
        except Exception:
            print("  [!] Geçersiz giriş. Tüm değişkenler kullanılıyor.")
            return VAR_NAMES

    prompt = "  X (bağımsız) numarası [0=tüm çiftler]: " if allow_all else "  X (bağımsız) numarası: "
    x_raw = input(prompt).strip()

    if x_raw == "0" and allow_all:
        return list(permutations(VAR_NAMES, 2))

    try:
        x_name = VAR_NAMES[int(x_raw) - 1]
    except (ValueError, IndexError):
        print("  [!] Geçersiz giriş. Tüm çiftler kullanılıyor.")
        return list(permutations(VAR_NAMES, 2))

    y_raw = input("  Y (bağımlı)  numarası: ").strip()
    try:
        y_name = VAR_NAMES[int(y_raw) - 1]
    except (ValueError, IndexError):
        print("  [!] Geçersiz giriş. Tüm çiftler kullanılıyor.")
        return list(permutations(VAR_NAMES, 2))

    if x_name == y_name:
        print("  [!] X ve Y aynı olamaz. Tüm çiftler kullanılıyor.")
        return list(permutations(VAR_NAMES, 2))

    print(f"\n  Seçim: {x_name} → {y_name}\n")
    return [(x_name, y_name)]

def run_granger():
    rows = []
    pairs = select_pairs()
    for x_name, y_name in pairs:
        x = VARIABLES[x_name]; y = VARIABLES[y_name]
        data = pd.concat([y, x], axis=1).dropna()
        best_lag, best_p, best_f = 1, 1.0, 0.0
        for lag in range(1, min(MAX_LAG+1, len(data)//4)):
            try:
                res = grangercausalitytests(data, maxlag=lag, verbose=False)
                p = res[lag]["ssr_ftest"][1]
                f = res[lag]["ssr_ftest"][0]
                if p < best_p: best_lag, best_p, best_f = lag, p, f
            except Exception: pass
        pair_str = f"{x_name} → {y_name}"
        n = len(data) - best_lag
        rows.append((pair_str, best_lag, pair_str, best_f, best_p, best_lag, n-best_lag-1,
                     karar(best_p)))
    print_caus_table(
        "Granger Nedensellik Testi",
        f"H0: X, Y'nin Granger nedeni değildir  |  En düşük p-value'lu lag seçilir  |  α = {ALPHA}",
        rows, stat_label="F-stat", extra_label="lag", extra2_label="df2",
        note="Her yön ayrı test edilir. X→Y reddi, Y→X'i garanti etmez.")

def run_toda_yamamoto():
    rows = []
    pairs = select_pairs()
    for x_name, y_name in pairs:
        x = VARIABLES[x_name]; y = VARIABLES[y_name]
        d_x = get_integration_order(x)
        d_y = get_integration_order(y)
        m = max(d_x, d_y)
        data = pd.concat([y, x], axis=1).dropna()
        try:
            model = VAR(data)
            lag_res = model.select_order(maxlags=MAX_LAG)
            p_opt = lag_res.aic if lag_res.aic > 0 else 1
            p_total = p_opt + m
            fit = model.fit(p_total)
            # Wald testi: ilk p_opt gecikmedeki x katsayıları
            from statsmodels.stats.wald import wald_test
            n_eq = 2
            n_coef = fit.params.shape[0]
            # x katsayı indeksleri (y denkleminde)
            restr = np.zeros((p_opt, n_coef))
            for i in range(p_opt):
                restr[i, 1 + i*n_eq + 1] = 1  # x → y yönü
            try:
                wt = fit.wald_test(restr, equation=0)
                chi2 = float(wt.statistic)
                wp   = float(wt.pvalue)
            except Exception:
                chi2, wp = np.nan, np.nan
            pair_str = f"{x_name} → {y_name}"
            rows.append((pair_str, p_opt, pair_str, chi2, wp, p_opt, m,
                         karar(wp) if not np.isnan(wp) else "—"))
        except Exception as e:
            pair_str = f"{x_name} → {y_name}"
            rows.append((pair_str, 0, pair_str, np.nan, np.nan, 0, m, f"Hata"))
    print_caus_table(
        "Toda-Yamamoto Nedensellik Testi",
        f"H0: X, Y'nin Granger nedeni değildir  |  Entegrasyon derecesinden bağımsız  |  α = {ALPHA}",
        rows, stat_label="Chi2", extra_label="p_opt", extra2_label="dmax",
        note="p_opt: optimal gecikme  |  dmax: max entegrasyon derecesi")

def run_hsiao():
    rows = []
    pairs = select_pairs()
    for x_name, y_name in pairs:
        x = VARIABLES[x_name]; y = VARIABLES[y_name]
        data = pd.concat([y, x], axis=1).dropna()
        # Adım 1: Kısıtlı model (sadece y'nin gecikmesi) — AIC ile m seçimi
        best_m, best_aic_r = 1, np.inf
        for m in range(1, min(MAX_LAG+1, len(data)//4)):
            try:
                res = grangercausalitytests(data, maxlag=m, verbose=False)
                aic_r = res[m]["params_ftest"][0]  # proxy
                if aic_r < best_aic_r: best_m, best_aic_r = m, aic_r
            except Exception: pass
        # Adım 2: Granger testi optimal gecikme ile
        try:
            res = grangercausalitytests(data, maxlag=best_m, verbose=False)
            f  = res[best_m]["ssr_ftest"][0]
            p  = res[best_m]["ssr_ftest"][1]
            df1 = res[best_m]["ssr_ftest"][2]
            df2 = int(res[best_m]["ssr_ftest"][3])
        except Exception:
            f, p, df1, df2 = np.nan, np.nan, 0, 0
        pair_str = f"{x_name} → {y_name}"
        rows.append((pair_str, best_m, pair_str, f if not np.isnan(f) else 0,
                     p if not np.isnan(p) else 1, int(df1), df2,
                     karar(p) if not np.isnan(p) else "—"))
    print_caus_table(
        "Hsiao Nedensellik Testi",
        f"H0: X, Y'nin Granger nedeni değildir  |  AIC ile optimal gecikme  |  α = {ALPHA}",
        rows, stat_label="F-stat", extra_label="df1", extra2_label="df2",
        note="Gecikme AIC minimizasyonu ile ayrı ayrı seçilir (Hsiao 1981)")

def run_ecm_causality():
    if len(VAR_NAMES) < 2:
        print("\n  [!] En az 2 değişken gereklidir.\n"); return
    rows = []
    pairs = select_pairs()
    for x_name, y_name in pairs:
        x = VARIABLES[x_name]; y = VARIABLES[y_name]
        data = pd.concat([y, x], axis=1).dropna()
        try:
            # Koentegrasyon kontrolü (Engle-Granger)
            _, p_coint, _ = coint(y.dropna(), x.dropna())
            # ECM artığı
            reg = OLS(y, add_constant(x)).fit()
            ecm_resid = reg.resid
            # Kısa dönem ECM (birinci fark + hata düzeltme terimi)
            dy = y.diff().dropna()
            dx = x.diff().dropna()
            ecm_lag = ecm_resid.shift(1).dropna()
            idx = dy.index.intersection(dx.index).intersection(ecm_lag.index)
            endog = dy.loc[idx]
            exog = pd.concat([dx.loc[idx], ecm_lag.loc[idx]], axis=1)
            exog = add_constant(exog)
            ecm_fit = OLS(endog, exog).fit()
            ecm_t = ecm_fit.tvalues.iloc[-1]
            ecm_p = ecm_fit.pvalues.iloc[-1]
            pair_str = f"{x_name} → {y_name}"
            rows.append((pair_str, 1, pair_str, ecm_t, ecm_p,
                         round(p_coint, 4), len(idx),
                         karar(ecm_p)))
        except Exception as e:
            pair_str = f"{x_name} → {y_name}"
            rows.append((pair_str, 0, pair_str, np.nan, np.nan, np.nan, 0, "Hata"))
    print_caus_table(
        "Engle-Granger ECM Nedensellik Testi",
        f"H0: Uzun dönem nedensellik yoktur  |  α = {ALPHA}",
        rows, stat_label="ECM t-stat", extra_label="p_coint", extra2_label="n",
        note="p_coint: Engle-Granger koentegrasyon p-value  |  ECM t-stat: hata düzeltme katsayısı")

def run_breitung_candelon():
    try:
        from scipy import signal
    except ImportError:
        print("\n  [!] pip install scipy\n"); return
    if len(VAR_NAMES) < 2:
        print("\n  [!] En az 2 değişken gereklidir.\n"); return

    # Frekans noktaları: 4 temel frekans
    freqs = [np.pi/6, np.pi/4, np.pi/2, np.pi]
    freq_labels = ["π/6 (uzun)", "π/4 (orta)", "π/2 (kısa)", "π (çok kısa)"]

    # Tablo başlığı farklı yapıda
    FW = {"pair":28, "freq":14, "chi2":10, "p":8, "lag":5, "karar":22}
    _FW = sum(FW.values()) + len(FW) - 1

    print_test_header("Breitung-Candelon Frekans Alanı Nedensellik Testi",
                      f"H0: ω frekansında X, Y'nin nedeni değildir  |  α = {ALPHA}")
    dline(_FW)
    print(f"  {'Bağıntı (X → Y)':<{FW['pair']}} {'Frekans':<{FW['freq']}} "
          f"{'Chi2':>{FW['chi2']}} {'p-value':>{FW['p']}} {'Lag':>{FW['lag']}} "
          f"{'Karar':<{FW['karar']}}")
    sline(_FW)

    pairs = select_pairs()
    prev = None
    for x_name, y_name in pairs:
        x = VARIABLES[x_name]; y = VARIABLES[y_name]
        data = pd.concat([y, x], axis=1).dropna().values
        pair_str = f"{x_name} → {y_name}"
        if prev is not None and prev != pair_str: sep(_FW)
        # Optimal gecikme
        try:
            var_m = VAR(pd.concat([y,x],axis=1).dropna())
            p_opt = var_m.select_order(maxlags=min(MAX_LAG,8)).aic
            p_opt = max(1, p_opt)
        except Exception:
            p_opt = 2
        for i, (freq, flabel) in enumerate(zip(freqs, freq_labels)):
            try:
                # Breitung-Candelon: cos/sin regresyon kısıt testi
                T = len(data)
                y_arr = data[:, 0]; x_arr = data[:, 1]
                # Birinci fark (I(1) için)
                dy = np.diff(y_arr); dx = np.diff(x_arr)
                T2 = len(dy)
                cos_t = np.cos(freq * np.arange(1, T2+1))
                sin_t = np.sin(freq * np.arange(1, T2+1))
                # Regresör matrisi: gecikmeler + cos + sin
                lags_y = np.column_stack([dy[p_opt-k:T2-k] for k in range(1, p_opt+1)])
                lags_x = np.column_stack([dx[p_opt-k:T2-k] for k in range(1, p_opt+1)])
                cos_r = cos_t[p_opt:]
                sin_r = sin_t[p_opt:]
                endog = dy[p_opt:]
                exog_r = add_constant(np.column_stack([lags_y, lags_x]))
                exog_u = add_constant(np.column_stack([lags_y, lags_x, cos_r, sin_r]))
                rss_r = OLS(endog, exog_r).fit().ssr
                rss_u = OLS(endog, exog_u).fit().ssr
                n_obs = len(endog)
                chi2 = n_obs * (rss_r - rss_u) / rss_u
                from scipy.stats import chi2 as chi2_dist
                p_val = 1 - chi2_dist.cdf(chi2, df=2)
                vn = pair_str if i == 0 else ""
                print(f"  {vn:<{FW['pair']}} {flabel:<{FW['freq']}} "
                      f"{chi2:>{FW['chi2']}.4f} {p_val:>{FW['p']}.4f} "
                      f"{p_opt:>{FW['lag']}} {karar(p_val):<{FW['karar']}}")
            except Exception as e:
                vn = pair_str if i == 0 else ""
                print(f"  {vn:<{FW['pair']}} {flabel:<{FW['freq']}} {'—':>{FW['chi2']}} "
                      f"{'—':>{FW['p']}} {p_opt:>{FW['lag']}} Hata: {e}")
        prev = pair_str
    dline(_FW)
    print(f"  Not: π/6≈0.52 uzun dönem | π/4≈0.79 orta | π/2≈1.57 kısa | π≈3.14 çok kısa periyot\n")

