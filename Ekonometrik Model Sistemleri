def run_gregory_hansen():
    if len(VAR_NAMES) < 2:
        print("\n  [!] En az 2 değişken gereklidir.\n"); return

    GW = {"pair":28,"model":16,"stat":11,"bp":12,"c1":8,"c5":8,"c10":8,"karar":22}
    _GW = sum(GW.values()) + len(GW) - 1

    print_test_header("Gregory-Hansen Eşbütünleşme Testi (1996)",
                      f"H0: Kırılmalı eşbütünleşme yoktur  |  α = {ALPHA}")
    dline(_GW)
    print(f"  {'Bağıntı':<{GW['pair']}} {'Model':<{GW['model']}} "
          f"{'ADF stat':>{GW['stat']}} {'Kırılma':>{GW['bp']}} "
          f"{'Krit.1%':>{GW['c1']}} {'Krit.5%':>{GW['c5']}} "
          f"{'Krit.10%':>{GW['c10']}} {'Karar':<{GW['karar']}}")
    sline(_GW)

    # GH kritik değerleri (Gregory-Hansen 1996, Tablo 1 - ADF)
    GH_CRIT = {
        "C":    {"1%": -5.13, "5%": -4.61, "10%": -4.34},
        "C/T":  {"1%": -5.45, "5%": -4.99, "10%": -4.72},
        "C/S":  {"1%": -5.47, "5%": -4.95, "10%": -4.68},
    }

    pairs = select_pairs()
    prev = None
    for x_name, y_name in pairs:
        x = VARIABLES[x_name]; y = VARIABLES[y_name]
        pair_str = f"{y_name} ~ {x_name}"
        if prev is not None and prev != pair_str: sep(_GW)
        for model_label in ["C", "C/T", "C/S"]:
            try:
                y_s = y.dropna(); x_s = x.dropna()
                idx = y_s.index.intersection(x_s.index)
                y_s = y_s.loc[idx].values; x_s = x_s.loc[idx].values
                T = len(y_s)
                trim = int(0.15 * T)
                min_stat, min_bp = np.inf, trim
                for bp in range(trim, T - trim):
                    du = np.zeros(T); du[bp:] = 1
                    if model_label == "C":
                        X = add_constant(np.column_stack([x_s, du]))
                    elif model_label == "C/T":
                        t = np.arange(T)
                        X = add_constant(np.column_stack([x_s, du, t]))
                    else:  # C/S
                        X = add_constant(np.column_stack([x_s, du, x_s * du]))
                    resid = OLS(y_s, X).fit().resid
                    adf_s = adfuller(resid, maxlag=MAX_LAG, autolag="AIC", regression="nc")[0]
                    if adf_s < min_stat:
                        min_stat, min_bp = adf_s, bp
                crit = GH_CRIT[model_label]
                k = "[ + ] Ret" if min_stat < crit["5%"] else "[ - ] Red Edilemedi"
                try: bp_label = str(idx[min_bp])[:10]
                except: bp_label = str(min_bp)
                vn = pair_str if model_label == "C" else ""
                print(f"  {vn:<{GW['pair']}} {model_label:<{GW['model']}} "
                      f"{min_stat:>{GW['stat']}.4f} {bp_label:>{GW['bp']}} "
                      f"{crit['1%']:>{GW['c1']}.3f} {crit['5%']:>{GW['c5']}.3f} "
                      f"{crit['10%']:>{GW['c10']}.3f} {k:<{GW['karar']}}")
            except Exception as e:
                vn = pair_str if model_label == "C" else ""
                print(f"  {vn:<{GW['pair']}} {model_label:<{GW['model']}}  Hata: {e}")
        prev = pair_str
    dline(_GW)
    print(f"  Not: C=sabit kırılma | C/T=trend kırılma | C/S=rejim kayması\n")

def run_ardl_bounds():
    if len(VAR_NAMES) < 2:
        print("\n  [!] En az 2 değişken gereklidir.\n"); return
    pairs = select_pairs()

    # PSS (2001) F-stat kritik değerleri (k=1, sabit+trend için)
    PSS_CRIT = {
        "1%":  {"I(0)": 6.84, "I(1)": 7.84},
        "5%":  {"I(0)": 4.94, "I(1)": 5.73},
        "10%": {"I(0)": 4.04, "I(1)": 4.78},
    }

    BW = {"dep":20,"indep":20,"f_stat":10,"p":8,"cv_i0":8,"cv_i1":8,"karar":28}
    _BW = sum(BW.values()) + len(BW) - 1

    print_test_header("ARDL Bounds Testi — Pesaran, Shin & Smith (2001)",
                      f"H0: Seviyede uzun dönem ilişki yoktur  |  α = {ALPHA}")
    dline(_BW)
    print(f"  {'Bağımlı (Y)':<{BW['dep']}} {'Bağımsız (X)':<{BW['indep']}} "
          f"{'F-stat':>{BW['f_stat']}} {'p-value':>{BW['p']}} "
          f"{'CV I(0) 5%':>{BW['cv_i0']}} {'CV I(1) 5%':>{BW['cv_i1']}} "
          f"{'Karar':<{BW['karar']}}")
    sline(_BW)

    for x_name, y_name in pairs:
        x = VARIABLES[x_name]; y = VARIABLES[y_name]
        try:
            data = pd.concat([y, x], axis=1).dropna()
            # ARDL(p,q) modeli: Δy_t = c + Σ φ_i Δy_{t-i} + Σ θ_j Δx_{t-j} + δ1 y_{t-1} + δ2 x_{t-1}
            dy = data.iloc[:,0].diff().dropna()
            dx = data.iloc[:,1].diff().dropna()
            y_lag = data.iloc[:,0].shift(1).dropna()
            x_lag = data.iloc[:,1].shift(1).dropna()
            idx = dy.index.intersection(dx.index).intersection(y_lag.index).intersection(x_lag.index)
            endog = dy.loc[idx]
            # Optimal gecikme
            p_opt = min(4, len(idx)//8)
            cols = [y_lag.loc[idx], x_lag.loc[idx]]
            for p in range(1, p_opt+1):
                cols.append(dy.shift(p).loc[idx])
                cols.append(dx.shift(p).loc[idx])
            exog = add_constant(pd.concat(cols, axis=1).dropna())
            endog = endog.loc[exog.index]
            # Kısıtlı model (y_lag ve x_lag katsayıları = 0)
            fit_u = OLS(endog, exog).fit()
            fit_r = OLS(endog, exog.iloc[:, 2:]).fit()
            # F-stat
            r_sq = (fit_r.ssr - fit_u.ssr) / 2
            f_stat = r_sq / (fit_u.ssr / fit_u.df_resid)
            from scipy.stats import f as f_dist
            p_val = 1 - f_dist.cdf(f_stat, 2, fit_u.df_resid)
            cv_i0 = PSS_CRIT["5%"]["I(0)"]
            cv_i1 = PSS_CRIT["5%"]["I(1)"]
            if f_stat > cv_i1:
                k_str = "[ + ] Eşbütünleşme Var"
            elif f_stat < cv_i0:
                k_str = "[ - ] Eşbütünleşme Yok"
            else:
                k_str = "[ ? ] Sonuçsuz Bölge"
            print(f"  {y_name:<{BW['dep']}} {x_name:<{BW['indep']}} "
                  f"{f_stat:>{BW['f_stat']}.4f} {p_val:>{BW['p']}.4f} "
                  f"{cv_i0:>{BW['cv_i0']}.2f} {cv_i1:>{BW['cv_i1']}.2f} "
                  f"{k_str:<{BW['karar']}}")
        except Exception as e:
            print(f"  {y_name:<{BW['dep']}} {x_name:<{BW['indep']}}  Hata: {e}")
    dline(_BW)
    print(f"  Not: F > CV I(1) → eşbütünleşme var | F < CV I(0) → yok | arası → sonuçsuz\n")

