    for r in rows:
        if prev is not None and prev != r[0]: sep(_TW)
        print("  " + _urt_row(r[0] if prev != r[0] else "", *r[1:]))
        prev = r[0]
    dline(_TW)
    if note: print(f"  Not: {note}\n")

def print_integration_summary(i_orders):
    if not i_orders: return
    w = max(len(str(v)) for v, _ in i_orders) + 2
    t = w + 10
    sline(t)
    print(f"  {'ENTEGRASYon DERECESİ ÖZETİ':<{t}}")
    print(f"  {'ADF · Sabit Model · α = ' + str(ALPHA):<{t}}")
    sline(t)
    for var, deg in i_orders: print(f"  {str(var):<{w}}  {deg}")
    sline(t); print()

def karar_adf(p):  return "[ + ] Durağan"       if p <= ALPHA else "[ - ] Durağan Değil"
def karar_kpss(p): return "[ - ] Durağan Değil" if p < ALPHA  else "[ + ] Durağan"

def entegrasyon(series, fn):
    for d, s in enumerate([series, series.diff().dropna(), series.diff().diff().dropna()]):
        try:
            if fn(s) <= ALPHA: return f"I({d})"
        except Exception: pass
    return "I(?)"

def run_adf():
    rows, io = [], []
    for var, s in VARIABLES.items():
        for model, reg in [("Sabit","c"),("Sabit+Trend","ct")]:
            stat,p,lag,n,crit,_ = adfuller(s.dropna(), maxlag=MAX_LAG, autolag="AIC", regression=reg)
            rows.append((var,model,stat,p,n,lag,crit["1%"],crit["5%"],crit["10%"],karar_adf(p)))
        io.append((var, entegrasyon(s, lambda x: adfuller(x,autolag="AIC",regression="c")[1])))
    print_urt_table("ADF — Augmented Dickey-Fuller",
                    f"H0: Birim kök vardır  |  Gecikme: AIC  |  α = {ALPHA}", rows)
    print_integration_summary(io)

def run_pp():
    try: from arch.unitroot import PhillipsPerron
    except ImportError: print("\n  [!] pip install arch\n"); return
    rows, io = [], []
    for var, s in VARIABLES.items():
        for model, trend in [("Sabit","c"),("Sabit+Trend","ct")]:
            pp = PhillipsPerron(s.dropna(), trend=trend, lags=MAX_LAG)
            rows.append((var,model,pp.stat,pp.pvalue,pp.nobs,None,
                         pp.critical_values["1%"],pp.critical_values["5%"],
                         pp.critical_values["10%"],karar_adf(pp.pvalue)))
        io.append((var, entegrasyon(s, lambda x: PhillipsPerron(x,trend="c").pvalue)))
    print_urt_table("PP — Phillips-Perron",
                    f"H0: Birim kök vardır  |  Kernel: Bartlett-Newey-West  |  α = {ALPHA}",
                    rows, lag_label="—")
    print_integration_summary(io)

def run_kpss():
    rows, io = [], []
    for var, s in VARIABLES.items():
        for model, reg in [("Sabit","c"),("Sabit+Trend","ct")]:
            stat,p,lag,crit = kpss(s.dropna(), regression=reg, nlags="auto")
            rows.append((var,model,stat,p,len(s.dropna()),lag,
                         crit["1%"],crit["5%"],crit["10%"],karar_kpss(p)))
        io.append((var, entegrasyon(s, lambda x: 1-kpss(x,regression="c",nlags="auto")[1])))
    print_urt_table("KPSS — Kwiatkowski-Phillips-Schmidt-Shin",
                    f"H0: Seri DURAĞANDIR (ADF'nin tersi)  |  α = {ALPHA}", rows,
                    note="p < 0.05 → H0 reddedilir → Durağan değil  |  p > 0.05 → Durağan")
    print_integration_summary(io)

def run_dfgls():
    try: from arch.unitroot import DFGLS
    except ImportError: print("\n  [!] pip install arch\n"); return
    rows, io = [], []
    for var, s in VARIABLES.items():
        for model, trend in [("Sabit","c"),("Sabit+Trend","ct")]:
            d = DFGLS(s.dropna(), trend=trend, max_lags=MAX_LAG)
            rows.append((var,model,d.stat,d.pvalue,d.nobs,d.lags,
                         d.critical_values["1%"],d.critical_values["5%"],
                         d.critical_values["10%"],karar_adf(d.pvalue)))
        io.append((var, entegrasyon(s, lambda x: DFGLS(x,trend="c",max_lags=MAX_LAG).pvalue)))
    print_urt_table("DF-GLS — Elliott, Rothenberg & Stock (1996)",
                    f"H0: Birim kök vardır  |  GLS detrending  |  α = {ALPHA}", rows)
    print_integration_summary(io)

