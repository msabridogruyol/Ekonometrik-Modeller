def hline(n, ch="─"): return ch * n
def sep(n): print("  " + hline(n, "·"))
def dline(n): print("  " + hline(n, "═"))
def sline(n): print("  " + hline(n, "─"))

def print_test_header(title, subtitle, note=""):
    print(f"\n  {title}")
    print(f"  {subtitle}")

def karar(p, reverse=False):
    if reverse:
        return "[ - ] Durağan Değil" if p < ALPHA else "[ + ] Durağan"
    return "[ + ] Ret" if p <= ALPHA else "[ - ] Red Edilemedi"

